# ======================================================
# AI Engineering Workspace - Environment Configuration
# ======================================================
#
# Instructions:
# 1. Copy this file and rename it to ".env"
# 2. Replace the placeholder values with your own.
# 3. Never commit your actual .env file to GitHub.
#
# ======================================================

# -----------------------------
# Database Configuration
# -----------------------------
DATABASE_URL=sqlite:///workspace.db

# -----------------------------
# JWT Authentication
# -----------------------------
SECRET_KEY=CHANGE_ME_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------
# Google Gemini API
# -----------------------------
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY

# -----------------------------
# LLM Provider Configuration
# -----------------------------
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash

# -----------------------------
# CORS Configuration
# -----------------------------
# Comma-separated browser origins. Production must set the real frontend origin
# (for example https://app.example.com). Do not use *.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# -----------------------------
# Application Settings
# -----------------------------
APP_ENV=development
LOG_LEVEL=INFO
CODE_EXECUTION_TIMEOUT=10